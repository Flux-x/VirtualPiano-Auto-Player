# VirtualPiano Auto Player - Git Ignore Rules

# Operating System Files
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editor & IDE Directories
.vscode/
.idea/
*.sublime-project
